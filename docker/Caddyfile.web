# Serve os arquivos estáticos do front-end dentro da rede interna do Compose.
:8080 {
	root * /srv
	encode gzip

	# Mesmos cabeçalhos de segurança da API (RNF10).
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# index.html nunca é armazenado em cache; os arquivos com hash podem ser.
	@estaticos path /assets/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-store"

	try_files {path} /index.html
	file_server
}
