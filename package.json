{
  "name": "vulncase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @vulncase/backend --filter @vulncase/frontend dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "aceite": "node scripts/roteiro-aceite.cjs docs/aceite",
    "verificacao": "node scripts/verificacao-seguranca.cjs docs/verificacao/resultados.json",
    "verificacao:registrar": "node scripts/registrar-verificacao.cjs docs/verificacao/resultados.json docs/verificacao"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^3.0.1",
    "playwright": "^1.65.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
