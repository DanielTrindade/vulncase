# Proxy reverso: front-end e API na mesma origem, com HTTPS local (CA interna do Caddy).
{
	admin off
}

localhost {
	# Limite de corpo no proxy (RNF14, A14): evidência de até 5 MB mais a folga do
	# multipart. A API aplica o limite exato do arquivo e 64 KB para JSON.
	request_body {
		max_size 6MB
	}

	# Não anuncia o servidor.
	header -Server

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
