# Proxy reverso: front-end e API na mesma origem, com HTTPS local (CA interna do Caddy).
{
	admin off
	# Clientes que não enviam SNI para "localhost" (ex.: Java/OWASP ZAP) recebem o certificado do site.
	default_sni localhost
}

localhost {
	# Limite de corpo no proxy (RNF14, A14): evidência de até 5 MB mais a folga do
	# multipart. A API aplica o limite exato do arquivo e 64 KB para JSON.
	request_body {
		max_size 6MB
	}

	# Não anuncia o servidor; HSTS também nas respostas do front-end.
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:8080
	}
}
