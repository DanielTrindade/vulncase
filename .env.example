# Copie para .env e preencha. Nunca versione o arquivo .env (RNF12).

# Senha do PostgreSQL (o Compose monta DATABASE_URL a partir dela).
POSTGRES_PASSWORD=

# Usada apenas fora do Docker (ex.: pnpm dev). No Compose é sobrescrita.
DATABASE_URL=postgres://vulncase:SENHA@localhost:5432/vulncase

# Origem aceita pelo middleware csrf.
ORIGEM_PERMITIDA=https://localhost

EVIDENCIAS_DIRETORIO=/data/evidencias
EVIDENCIAS_TAMANHO_MAXIMO_BYTES=5242880

# Primeiro administrador, criado apenas quando o banco não tem usuários.
ADMIN_EMAIL_INICIAL=
ADMIN_SENHA_INICIAL=

NODE_ENV=production

# Senha dos usuários da carga de demonstração (apenas NODE_ENV=development).
DEMO_SENHA=

# Prazos de correção em dias por severidade (RN10). Informativa não tem prazo.
PRAZO_DIAS_CRITICA=7
PRAZO_DIAS_ALTA=30
PRAZO_DIAS_MEDIA=90
PRAZO_DIAS_BAIXA=180
